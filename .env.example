# PostgreSQL connection string (managed Postgres: Supabase / Neon / Render)
DATABASE_URL="postgresql://tripapp:tripapp@localhost:5432/tripapp"

# Secret used to encrypt the admin session cookie (iron-session). Min 32 chars.
SESSION_SECRET="change-me-to-a-random-string-of-32-plus-chars"

# Admin session inactivity TTL in minutes (FSD §4.1, default 45)
SESSION_TTL_MINUTES=45

# Seed credentials for the single admin user (used by `npm run db:seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Cloudinary (FSD §4.6) — signed direct-to-Cloudinary uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="tripapp"

# Optional webhook stub fired on every new enquiry (FSD §8.3).
# Leave empty to disable. Wire to an email/SMS provider later.
ENQUIRY_WEBHOOK_URL=""
