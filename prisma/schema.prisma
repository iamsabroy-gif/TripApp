// Physical data model per FSD §5 — table/column names kept identical to the
// SQL in the spec via @@map/@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  DRAFT
  PUBLISHED

  @@map("trip_status")
}

enum DifficultyLevel {
  EASY
  MODERATE
  DIFFICULT

  @@map("difficulty_level")
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("admin_user")
}

model Trip {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(150)
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime         @map("end_date") @db.Date
  coverImageUrl    String?          @map("cover_image_url")
  coverImagePublicId String?        @map("cover_image_public_id")
  shortDescription String?          @map("short_description")
  difficulty       DifficultyLevel?
  basePrice        Decimal?         @map("base_price") @db.Decimal(10, 2)
  status           TripStatus       @default(DRAFT)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  days      ItineraryDay[]
  enquiries Enquiry[]

  @@index([status], map: "idx_trip_status")
  @@map("trip")
}

model ItineraryDay {
  id             String  @id @default(uuid()) @db.Uuid
  tripId         String  @map("trip_id") @db.Uuid
  dayNumber      Int     @map("day_number")
  locationName   String  @map("location_name") @db.VarChar(150)
  latitude       Decimal @db.Decimal(9, 6)
  longitude      Decimal @db.Decimal(9, 6)
  dayDescription String? @map("day_description")
  sortOrder      Int     @map("sort_order")

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sites Site[]

  @@unique([tripId, sortOrder])
  @@index([tripId], map: "idx_itinerary_day_trip")
  @@map("itinerary_day")
}

model Site {
  id              String  @id @default(uuid()) @db.Uuid
  dayId           String  @map("day_id") @db.Uuid
  siteName        String  @map("site_name") @db.VarChar(150)
  siteDescription String? @map("site_description")

  day    ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  images SiteImage[]

  @@index([dayId], map: "idx_site_day")
  @@map("site")
}

model SiteImage {
  id            String  @id @default(uuid()) @db.Uuid
  siteId        String  @map("site_id") @db.Uuid
  imageUrl      String  @map("image_url")
  cloudPublicId String? @map("cloud_public_id")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId], map: "idx_site_image_site")
  @@map("site_image")
}

model Enquiry {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  name        String   @db.VarChar(100)
  phone       String   @db.VarChar(15)
  email       String   @db.VarChar(150)
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz()

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId], map: "idx_enquiry_trip")
  @@index([submittedAt], map: "idx_enquiry_submitted")
  @@map("enquiry")
}
